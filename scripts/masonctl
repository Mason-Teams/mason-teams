# masonctl - MASON Teams v1 is deprecated.
#
# This is the masonctl published to users. Every command, and running it with
# no arguments, prints the deprecation notice and exits non-zero. It never
# calls docker.

cat >&2 <<'NOTICE'

  ================================================================
    THANK YOU TO OUR USERS
    MASON Teams v1 has been DEPRECATED and is no longer supported.
  ================================================================

  Thank you to everyone who built with MASON Teams.

  What this means for you:
    - masonctl no longer runs any commands.
    - The MASON Teams container image is no longer available to download.
    - An installation you already have keeps running as it is.
      To stop and remove it yourself, use Docker directly:
          docker stop mason
          docker rm mason
      Removing the container does not delete your data; it stays in
      the Docker volume "mason-data".

  The repository and its files are being left in place for
  archival purposes only.

NOTICE
exit 1
